<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Debug builds only. `tools/deploy.sh` serves the next APK over plain http
      on the local network, and the Dev panel downloads it. Android blocks
      plain http for any app that targets SDK 28 or later unless the app says
      this. The release build does not say it: its one network job, the in-app
      update, talks to GitHub over https only.
    -->
    <application android:usesCleartextTraffic="true" />

</manifest>
