<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      E-ink rule 1: no animations. The window animation style below turns off
      every activity and task transition the platform would otherwise play.
    -->
    <style name="Animation.EinkLauncher.None" parent="@android:style/Animation">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:taskOpenEnterAnimation">@null</item>
        <item name="android:taskOpenExitAnimation">@null</item>
        <item name="android:taskCloseEnterAnimation">@null</item>
        <item name="android:taskCloseExitAnimation">@null</item>
        <item name="android:taskToFrontEnterAnimation">@null</item>
        <item name="android:taskToFrontExitAnimation">@null</item>
        <item name="android:taskToBackEnterAnimation">@null</item>
        <item name="android:taskToBackExitAnimation">@null</item>
        <item name="android:wallpaperOpenEnterAnimation">@null</item>
        <item name="android:wallpaperOpenExitAnimation">@null</item>
        <item name="android:wallpaperCloseEnterAnimation">@null</item>
        <item name="android:wallpaperCloseExitAnimation">@null</item>
        <item name="android:wallpaperIntraOpenEnterAnimation">@null</item>
        <item name="android:wallpaperIntraOpenExitAnimation">@null</item>
        <item name="android:wallpaperIntraCloseEnterAnimation">@null</item>
        <item name="android:wallpaperIntraCloseExitAnimation">@null</item>
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>

    <style name="Theme.EinkLauncher" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/eink_paper</item>
        <item name="android:colorBackground">@color/eink_paper</item>
        <item name="android:textColorPrimary">@color/eink_ink</item>
        <item name="android:textColorSecondary">@color/eink_ink</item>
        <item name="android:statusBarColor">@color/eink_paper</item>
        <item name="android:navigationBarColor">@color/eink_paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.EinkLauncher.None</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:dialogTheme">@style/Theme.EinkLauncher.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.EinkLauncher.Dialog</item>
    </style>

    <!--
      Every dialog window. No fade in, no fade out, and no grey wash over the
      screen behind it: on e-ink the wash is a full repaint of dithered grey
      when the dialog comes and another when it goes. The theme is read before
      the window first shows, which code in the dialog itself is too late for.
    -->
    <style name="Theme.EinkLauncher.Dialog" parent="@android:style/Theme.Material.Light.Dialog">
        <item name="android:windowAnimationStyle">@style/Animation.EinkLauncher.None</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowElevation">0dp</item>
    </style>

</resources>
