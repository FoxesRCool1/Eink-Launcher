<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Readium brings the media player it uses for audiobooks, and that asks
      for a wake lock. This app plays no audio, on a tablet with no speaker.
      A permission nobody uses has no place in the list the user reads.
    -->
    <uses-permission
        android:name="android.permission.WAKE_LOCK"
        tools:node="remove" />

    <!-- Needed for the Wi-Fi icon in the status line on Home. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      The in-app update, and nothing else. The app goes online only when the
      user presses "Check for updates", and then only to GitHub: it reads the
      list of releases and fetches one APK. The second permission lets it hand
      that APK to Android, which still asks the user before it installs.
      See docs/decisions/0012-in-app-updates.md.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Package visibility. A launcher has to see every app that can be started,
      every other home app, and the system settings. Android 11 and later hide
      other packages unless the app asks like this.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.HOME_SETTINGS" />
        </intent>
    </queries>

    <application
        android:name=".EinkLauncherApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.EinkLauncher">

        <!--
          Turning the screen. No activity below is locked upright in this
          file. Each one asks ScreenWindow which way the screen should be,
          from the setting the small icon at the top of every screen changes.
          Each one also handles "orientation|screenSize" itself, so a turn
          does not build the activity again: the open book, the ink on the
          page and the half typed note stay, and Compose lays the screen out
          again at the new size. The two device test screens at the end stay
          locked upright. They are tools, and a turn would wipe their results.

          The home screen.

          singleTask plus stateNotNeeded is what a launcher needs: the Home key
          brings this same task forward instead of starting a second copy, and
          the system can kill it and bring it back without saved state.

          The LAUNCHER category is here as well as HOME, so the owner can open
          the app from the stock launcher before it is the default one. The
          stock launcher on this tablet hides a lot, so that route matters.
        -->
        <activity
            android:name=".HomeActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.EinkLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The typed note editor. Its own activity, so the Home key closes the
          launcher and not the note the user is in the middle of writing.

          configChanges, the keyboard part: a Bluetooth keyboard that wakes up or goes to sleep is
          a configuration change. Without this line Android would build the
          editor again each time, and the cursor would jump to the end of the
          note in the middle of a sentence.
        -->
        <activity
            android:name=".ui.writing.NoteEditorActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.EinkLauncher"
            android:windowSoftInputMode="adjustResize" />

        <!--
          The design system demo. A separate activity, so the launcher task
          stays clean and the Home key still goes to Home.
        -->
        <activity
            android:name=".DemoActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:label="@string/demo_title"
            android:theme="@style/Theme.EinkLauncher" />

        <!-- The EPUB reader, on the Readium toolkit. Its own activity, as the plan says. -->
        <activity
            android:name=".ui.reading.epub.EpubReaderActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.EinkLauncher"
            android:windowSoftInputMode="adjustResize" />

        <!-- The PDF reader: one screen of a page at a time, with ink on top. -->
        <activity
            android:name=".ui.reading.pdf.PdfReaderActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.EinkLauncher"
            android:windowSoftInputMode="adjustResize" />

        <!--
          A handwritten note. Writing, Journal and the reader all open it.
          Its own activity for the same reason as the typed editor.
        -->
        <activity
            android:name=".ui.ink.InkNoteActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.EinkLauncher" />

        <!--
          One page of the launcher in a task of its own, so Android's split
          screen can put another app beside it. Android never splits the task
          of the home screen. See ui/split/AdjacentApps.kt.
        -->
        <activity
            android:name=".ui.split.BesideActivity"
            android:taskAffinity="${applicationId}.beside"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.EinkLauncher"
            android:windowSoftInputMode="adjustResize" />

        <!-- The Step 2 device spike: refresh modes, fast pen paths, home role. -->
        <activity
            android:name=".ui.devicetest.DeviceTestActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EinkLauncher" />

        <activity
            android:name=".ui.devicetest.PenTestActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EinkLauncher" />

        <!-- Android reports the result of an update install here. -->
        <receiver
            android:name=".core.update.InstallStatusReceiver"
            android:exported="false" />

        <!--
          Shares one folder, cache/updates/, with the system installer. It is
          only used when this firmware refuses an install session.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

    </application>

</manifest>
